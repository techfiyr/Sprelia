# Copy to backend/.env for local development. NEVER commit .env.
# Placeholder values only. Deployed environments use Cloud Run env vars and
# Secret Manager; no secret is ever baked into an image or committed.

# ---------------------------------------------------------------------------
# Sprelia API (src/main.ts) — `npm run dev`
# ---------------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Firebase project ID whose ID tokens are accepted (not a secret; the ID, not the number).
# Local and tests: `demo-sprelia` (emulators). `sprelia` is PRODUCTION and is refused
# unless APP_ENV=production. Never use production credentials locally.
FIREBASE_PROJECT_ID=demo-sprelia

# Local only: Firebase Emulator Suite (`firebase emulators:start --only auth,firestore
# --project demo-sprelia` from the repo root). Auth emulator tokens are unsigned, so the
# server refuses to start with these in APP_ENV=staging|production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180

# Free plan AI speaking allowance per local day, in seconds (10 minutes).
FREE_DAILY_SECONDS=600

# Serve scenarios without human review (default: true outside production; never true in production).
# CATALOG_INCLUDE_DRAFTS=true

# Reject revoked sessions / disabled users (forced true in staging/production).
AUTH_CHECK_REVOKED=true

# Cloud Run: 1. Local: 0.
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120

# Credentials: use Application Default Credentials
# (`gcloud auth application-default login`) — do NOT download service-account keys.

# ---------------------------------------------------------------------------
# Legacy Express prototype (src/server.ts) — `npm run dev:prototype`
# Removed when conversations move to the Fastify API (Phase 6).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Superseded model IDs; verify against https://ai.google.dev/gemini-api/docs/models
# before use. Current IDs are adopted in Phase 6.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
FREE_DAILY_SECONDS=600
# Trusts the x-dev-user-id header instead of a Firebase ID token.
# Prototype only, local machine only. Must stay false anywhere else.
DEV_SKIP_AUTH=false
