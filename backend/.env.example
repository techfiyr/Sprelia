# Copy to .env. Never commit .env.
GEMINI_API_KEY=
# Check current model IDs at https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
PORT=8080
FREE_DAILY_SECONDS=600
# Prototype only: trust the x-dev-user-id header instead of a Firebase ID token.
# MUST be false (or unset) in any deployed environment.
DEV_SKIP_AUTH=true
