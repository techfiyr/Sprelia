# Copy to backend/.env for local development. NEVER commit .env.
# Against the shared project instead of the emulators: `npm run dev:sprelia`, which reads the
# gitignored `.env.sprelia.local` (FIREBASE_PROJECT_ID=sprelia, no emulator hosts, App Check off;
# needs `gcloud auth application-default login`).
# Placeholder values only. Deployed environment (Netlify, see doc/DEPLOYMENT_NETLIFY.md) uses
# Netlify environment variables; no secret is ever committed.

# ---------------------------------------------------------------------------
# Sprelia API (src/main.ts) — `npm run dev`
# ---------------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Firebase project ID whose ID tokens are accepted (not a secret; the ID, not the number).
# Single approved project (owner decision 2026-11-09): `sprelia` for development (pre-launch,
# test accounts only), staging and production. `demo-sprelia` = local emulators. Any other
# project is refused; APP_ENV=test refuses everything except demo-* projects.
FIREBASE_PROJECT_ID=demo-sprelia

# Local only: Firebase Emulator Suite (`firebase emulators:start --only auth,firestore
# --project demo-sprelia` from the repo root). Auth emulator tokens are unsigned, so the
# server refuses to start with these in APP_ENV=staging|production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180

# Free plan AI speaking allowance per local day, in seconds (10 minutes).
FREE_DAILY_SECONDS=600

# Serve scenarios without human review (default: true outside production; never true in production).
# CATALOG_INCLUDE_DRAFTS=true

# Reject revoked sessions / disabled users (forced true in staging/production).
AUTH_CHECK_REVOKED=true

# App Check on protected routes: off | monitor | enforce.
# Default: production enforce (required), staging monitor, development/test off.
# APP_CHECK_MODE=off

# Email/password accounts must verify their email before using /me (forced true in staging/production).
REQUIRE_EMAIL_VERIFICATION=true

# Account deletion requires a sign-in within this many seconds (60–3600).
RECENT_AUTH_MAX_AGE_SECONDS=300

# Local: 0. Netlify: must be 0 (client IP comes from context.ip; enforced).
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120

# Netlify only (owner authorized 2026-11-09): FIREBASE_SERVICE_ACCOUNT_JSON = full service-account key JSON,
# set as a Netlify secret env var in the Netlify UI (never here, never committed). Refused with emulators
# or APP_ENV=test. Leave unset locally (Application Default Credentials are used).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Credentials: use Application Default Credentials
# (`gcloud auth application-default login`) — do NOT download service-account keys.
# With FIREBASE_PROJECT_ID=sprelia (no emulators) the local server has full Admin access to
# the shared project: use test accounts only and never run destructive scripts against it.

# ---------------------------------------------------------------------------
# Legacy Express prototype (src/server.ts) — `npm run dev:prototype`
# Removed when conversations move to the Fastify API (Phase 6).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Superseded model IDs; verify against https://ai.google.dev/gemini-api/docs/models
# before use. Current IDs are adopted in Phase 6.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
FREE_DAILY_SECONDS=600
# Trusts the x-dev-user-id header instead of a Firebase ID token.
# Prototype only, local machine only. Must stay false anywhere else.
DEV_SKIP_AUTH=false
