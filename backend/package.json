{
  "name": "speakdaily-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:prototype": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-sprelia --config ../firebase.json \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@google/genai": "^3.0.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "firebase": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "Sprelia API (Fastify). src/server.ts is the legacy Express prototype.",
  "engines": {
    "node": ">=22"
  }
}
